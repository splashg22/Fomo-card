# Copy to .env and fill in what you have. Every variable is optional — with none of them set,
# Social Cash runs entirely in DEMO mode for FOMO: fomoapi.io calls return deterministic fake
# wallets/balances, and the card issuer defaults to a fake, clearly-labelled sandbox card with no
# real money movement. Pump.fun needs no key at all — it just reads your connected wallet's live
# on-chain balance. That's enough to exercise the whole connect -> load -> confirm -> spend UI
# before you have real keys.

# ---- Database ----
MONGO_URL=mongodb://localhost:27017
DB_NAME=socialcash

# ---- CORS ----
CORS_ORIGINS=*

# ---- fomoapi.io (independent FOMO handle/wallet/balance data — FOMO platform only) ----
FOMOAPI_KEY=
FOMOAPI_BASE_URL=https://api.fomoapi.io

# ---- Card issuer (both platforms fund through the same issuer) ----
# CARD_ISSUER=demo | cryptocardium   (default: cryptocardium if CRYPTOCARDIUM_API_KEY is set, else demo)
CARD_ISSUER=
CRYPTOCARDIUM_API_KEY=
CRYPTOCARDIUM_BASE_URL=https://api.cryptocardium.com/v1
# HMAC secret used to verify POST /api/webhooks/cryptocardium — get this from your issuer dashboard.
CRYPTOCARDIUM_WEBHOOK_SECRET=

# ---- On-chain reads ----
# Used for: (a) Pump.fun's live SOL/USDC balance read, (b) best-effort deposit confirmation for both
# platforms (issuer webhooks remain the real source of truth for confirmation).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
USDC_MINT_SOLANA=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
FOMOCARD_EVM_RPC_URL=
