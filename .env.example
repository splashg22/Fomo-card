# Copy to .env and fill in what you have. Every variable is optional — with none of them set,
# FOMO Card runs entirely in DEMO mode: fomoapi.io calls return deterministic fake wallets/balances,
# and the card issuer defaults to a fake, clearly-labelled sandbox card with no real money movement.
# That's enough to exercise the whole connect -> load -> confirm -> spend UI before you have real keys.

# ---- Database ----
MONGO_URL=mongodb://localhost:27017
DB_NAME=fomocard

# ---- CORS ----
CORS_ORIGINS=*

# ---- fomoapi.io (independent FOMO handle/wallet/balance data) ----
FOMOAPI_KEY=
FOMOAPI_BASE_URL=https://api.fomoapi.io

# ---- Card issuer ----
# CARD_ISSUER=demo | cryptocardium   (default: cryptocardium if CRYPTOCARDIUM_API_KEY is set, else demo)
CARD_ISSUER=
CRYPTOCARDIUM_API_KEY=
CRYPTOCARDIUM_BASE_URL=https://api.cryptocardium.com/v1
# HMAC secret used to verify POST /api/webhooks/cryptocardium — get this from your issuer dashboard.
CRYPTOCARDIUM_WEBHOOK_SECRET=

# ---- Optional on-chain deposit corroboration (issuer webhooks are the real source of truth) ----
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
FOMOCARD_EVM_RPC_URL=
